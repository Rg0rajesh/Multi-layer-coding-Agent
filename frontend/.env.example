# frontend/.env.example — copy to .env
#
# Leave these EMPTY for local dev. client.ts falls back to
# http://localhost:8000 only when the var is unset (??, not ||) — an
# empty string here is intentional and means "same origin as the page."
# That routes every request through vite.config.ts's dev proxy instead of
# straight to :8000, which matters because the refresh-token cookie is
# SameSite=lax and won't survive a real cross-origin request.
#
# For a production build served behind nginx.conf, leave these empty too
# — nginx already routes /api and /ws to the backend container on the
# same origin the page was served from.
VITE_API_URL=
VITE_WS_URL=

# Optional — only needed if you're testing the OAuth buttons on Login
VITE_GITHUB_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
